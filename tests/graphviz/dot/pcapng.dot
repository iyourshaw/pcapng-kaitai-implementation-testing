digraph {
	rankdir=LR;
	node [shape=plaintext];
	subgraph cluster__pcapng {
		label="Pcapng";
		graph[style=dotted];

		pcapng__seq [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
			<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
			<TR><TD PORT="sections_pos">0</TD><TD PORT="sections_size">...</TD><TD>SectionInFile</TD><TD PORT="sections_type">sections</TD></TR>
			<TR><TD COLSPAN="4" PORT="sections__repeat">repeat to end of stream</TD></TR>
		</TABLE>>];
		subgraph cluster__section {
			label="Pcapng::Section";
			graph[style=dotted];

			section__seq [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
				<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
				<TR><TD PORT="header_pos">0</TD><TD PORT="header_size">...</TD><TD>Block</TD><TD PORT="header_type">header</TD></TR>
				<TR><TD PORT="blocks_pos">...</TD><TD PORT="blocks_size">...</TD><TD>Block</TD><TD PORT="blocks_type">blocks</TD></TR>
				<TR><TD COLSPAN="4" PORT="blocks__repeat">repeat until _.ends_section</TD></TR>
				<TR><TD COLSPAN="4" PORT="blocks__if">if  ((is_supported_version) &amp;&amp; (!(header.ends_section))) </TD></TR>
				<TR><TD PORT="skipped_blocks_pos">...</TD><TD PORT="skipped_blocks_size">...</TD><TD>SkippedBlock</TD><TD PORT="skipped_blocks_type">skipped_blocks</TD></TR>
				<TR><TD COLSPAN="4" PORT="skipped_blocks__repeat">repeat until _.ends_section</TD></TR>
				<TR><TD COLSPAN="4" PORT="skipped_blocks__if">if  ((!(is_supported_version)) &amp;&amp; (!(header.ends_section))) </TD></TR>
			</TABLE>>];
			section__inst__is_le [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
				<TR><TD BGCOLOR="#E0FFE0">id</TD><TD BGCOLOR="#E0FFE0">value</TD></TR>
				<TR><TD>is_le</TD><TD>_parent.byte_order_magic == [77, 60, 43, 26].pack('C*')</TD></TR>
			</TABLE>>];
			section__inst__is_supported_version [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
				<TR><TD BGCOLOR="#E0FFE0">id</TD><TD BGCOLOR="#E0FFE0">value</TD></TR>
				<TR><TD>is_supported_version</TD><TD> ((header.body.version_major == 1) &amp;&amp; ( ((header.body.version_minor == 0) || (header.body.version_minor == 2)) )) </TD></TR>
			</TABLE>>];
			subgraph cluster__block {
				label="Pcapng::Section::Block";
				graph[style=dotted];

				block__seq [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
					<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
					<TR><TD PORT="block_type_pos">0</TD><TD PORT="block_type_size">4</TD><TD>u4→BlockType</TD><TD PORT="block_type_type">block_type</TD></TR>
					<TR><TD PORT="len_block_pos">4</TD><TD PORT="len_block_size">4</TD><TD>u4</TD><TD PORT="len_block_type">len_block</TD></TR>
					<TR><TD PORT="body_pos">8</TD><TD PORT="body_size">...</TD><TD>switch (block_type)</TD><TD PORT="body_type">body</TD></TR>
					<TR><TD PORT="len_block_trailing_pos">...</TD><TD PORT="len_block_trailing_size">4</TD><TD>u4</TD><TD PORT="len_block_trailing_type">len_block_trailing</TD></TR>
					<TR><TD COLSPAN="4" PORT="len_block_trailing__valid">must be equal to len_block</TD></TR>
				</TABLE>>];
				block__inst__ends_section [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
					<TR><TD BGCOLOR="#E0FFE0">id</TD><TD BGCOLOR="#E0FFE0">value</TD></TR>
					<TR><TD>ends_section</TD><TD> ((_io.eof?) || (next_block_type == [10, 13, 13, 10].pack('C*'))) </TD></TR>
				</TABLE>>];
				block__inst__next_block_type [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
					<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
					<TR><TD PORT="next_block_type_pos">_io.pos</TD><TD PORT="next_block_type_size">4</TD><TD></TD><TD PORT="next_block_type_type">next_block_type</TD></TR>
					<TR><TD COLSPAN="4" PORT="next_block_type__if">if !(_io.eof?)</TD></TR>
				</TABLE>>];
block__seq_body_switch [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
	<TR><TD BGCOLOR="#F0F2E4">case</TD><TD BGCOLOR="#F0F2E4">type</TD></TR>
	<TR><TD>:block_type_custom_copied</TD><TD PORT="case0">PcapngCustomBlock</TD></TR>
	<TR><TD>:block_type_custom_not_copied</TD><TD PORT="case1">PcapngCustomBlock</TD></TR>
	<TR><TD>:block_type_decryption_secrets</TD><TD PORT="case2">PcapngDecryptionSecretsBlock</TD></TR>
	<TR><TD>:block_type_enhanced_packet</TD><TD PORT="case3">PcapngEnhancedPacketBlock</TD></TR>
	<TR><TD>:block_type_interface_description</TD><TD PORT="case4">PcapngInterfaceDescriptionBlock</TD></TR>
	<TR><TD>:block_type_interface_statistics</TD><TD PORT="case5">PcapngInterfaceStatisticsBlock</TD></TR>
	<TR><TD>:block_type_name_resolution</TD><TD PORT="case6">PcapngNameResolutionBlock</TD></TR>
	<TR><TD>:block_type_packet</TD><TD PORT="case7">PcapngPacketBlock</TD></TR>
	<TR><TD>:block_type_section_header</TD><TD PORT="case8">PcapngSectionHeaderBlock</TD></TR>
	<TR><TD>:block_type_simple_packet</TD><TD PORT="case9">PcapngSimplePacketBlock</TD></TR>
</TABLE>>];
			}
			subgraph cluster__skipped_block {
				label="Pcapng::Section::SkippedBlock";
				graph[style=dotted];

				skipped_block__seq [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
					<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
					<TR><TD PORT="block_type_pos">0</TD><TD PORT="block_type_size">4</TD><TD>u4</TD><TD PORT="block_type_type">block_type</TD></TR>
					<TR><TD PORT="len_block_pos">4</TD><TD PORT="len_block_size">4</TD><TD>u4</TD><TD PORT="len_block_type">len_block</TD></TR>
					<TR><TD PORT="body_pos">8</TD><TD PORT="body_size">len_block - 12</TD><TD></TD><TD PORT="body_type">body</TD></TR>
					<TR><TD PORT="len_block_trailing_pos">...</TD><TD PORT="len_block_trailing_size">4</TD><TD>u4</TD><TD PORT="len_block_trailing_type">len_block_trailing</TD></TR>
					<TR><TD COLSPAN="4" PORT="len_block_trailing__valid">must be equal to len_block</TD></TR>
				</TABLE>>];
				skipped_block__inst__ends_section [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
					<TR><TD BGCOLOR="#E0FFE0">id</TD><TD BGCOLOR="#E0FFE0">value</TD></TR>
					<TR><TD>ends_section</TD><TD> ((_io.eof?) || (next_block_type == [10, 13, 13, 10].pack('C*'))) </TD></TR>
				</TABLE>>];
				skipped_block__inst__next_block_type [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
					<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
					<TR><TD PORT="next_block_type_pos">_io.pos</TD><TD PORT="next_block_type_size">4</TD><TD></TD><TD PORT="next_block_type_type">next_block_type</TD></TR>
					<TR><TD COLSPAN="4" PORT="next_block_type__if">if !(_io.eof?)</TD></TR>
				</TABLE>>];
			}
		}
		subgraph cluster__section_in_file {
			label="Pcapng::SectionInFile";
			graph[style=dotted];

			section_in_file__seq [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
				<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
				<TR><TD PORT="section_pos">0</TD><TD PORT="section_size">...</TD><TD>Section</TD><TD PORT="section_type">section</TD></TR>
			</TABLE>>];
			section_in_file__inst__byte_order_magic [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
				<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
				<TR><TD PORT="byte_order_magic_pos">_io.pos + 8</TD><TD PORT="byte_order_magic_size">4</TD><TD></TD><TD PORT="byte_order_magic_type">byte_order_magic</TD></TR>
			</TABLE>>];
		}
	}
	pcapng__seq:sections_type -> section_in_file__seq [style=bold];
	section__seq:header_type -> block__seq [style=bold];
	section__seq:blocks_type -> block__seq [style=bold];
	block__inst__ends_section:ends_section_type -> section__seq:blocks__repeat [color="#404040"];
	section__inst__is_supported_version:is_supported_version_type -> section__seq:blocks__if [color="#404040"];
	block__inst__ends_section:ends_section_type -> section__seq:blocks__if [color="#404040"];
	section__seq:skipped_blocks_type -> skipped_block__seq [style=bold];
	skipped_block__inst__ends_section:ends_section_type -> section__seq:skipped_blocks__repeat [color="#404040"];
	section__inst__is_supported_version:is_supported_version_type -> section__seq:skipped_blocks__if [color="#404040"];
	block__inst__ends_section:ends_section_type -> section__seq:skipped_blocks__if [color="#404040"];
	section_in_file__inst__byte_order_magic:byte_order_magic_type -> section__inst__is_le [color="#404040"];
	pcapng_section_header_block__seq:version_major_type -> section__inst__is_supported_version [color="#404040"];
	pcapng_section_header_block__seq:version_minor_type -> section__inst__is_supported_version [color="#404040"];
	block__seq:body_type -> block__seq_body_switch [style=bold];
	block__seq_body_switch:case0 -> pcapng_custom_block__seq [style=bold];
	block__seq_body_switch:case1 -> pcapng_custom_block__seq [style=bold];
	block__seq_body_switch:case2 -> pcapng_decryption_secrets_block__seq [style=bold];
	block__seq_body_switch:case3 -> pcapng_enhanced_packet_block__seq [style=bold];
	block__seq_body_switch:case4 -> pcapng_interface_description_block__seq [style=bold];
	block__seq_body_switch:case5 -> pcapng_interface_statistics_block__seq [style=bold];
	block__seq_body_switch:case6 -> pcapng_name_resolution_block__seq [style=bold];
	block__seq_body_switch:case7 -> pcapng_packet_block__seq [style=bold];
	block__seq_body_switch:case8 -> pcapng_section_header_block__seq [style=bold];
	block__seq_body_switch:case9 -> pcapng_simple_packet_block__seq [style=bold];
	block__seq:block_type_type -> block__seq:body_type [color="#404040"];
	block__seq:len_block_type -> block__seq:len_block_trailing__valid [color="#404040"];
	block__inst__next_block_type:next_block_type_type -> block__inst__ends_section [color="#404040"];
	skipped_block__seq:len_block_type -> skipped_block__seq:body_size [color="#404040"];
	skipped_block__seq:len_block_type -> skipped_block__seq:len_block_trailing__valid [color="#404040"];
	skipped_block__inst__next_block_type:next_block_type_type -> skipped_block__inst__ends_section [color="#404040"];
	section_in_file__seq:section_type -> section__seq [style=bold];
}

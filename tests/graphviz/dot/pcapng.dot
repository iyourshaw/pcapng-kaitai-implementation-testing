digraph {
	rankdir=LR;
	node [shape=plaintext];
	subgraph cluster__pcapng {
		label="Pcapng";
		graph[style=dotted];

		pcapng__seq [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
			<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
			<TR><TD PORT="sections_pos">0</TD><TD PORT="sections_size">...</TD><TD>SectionInFile</TD><TD PORT="sections_type">sections</TD></TR>
			<TR><TD COLSPAN="4" PORT="sections__repeat">repeat to end of stream</TD></TR>
		</TABLE>>];
		subgraph cluster__section {
			label="Pcapng::Section";
			graph[style=dotted];

			section__seq [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
				<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
				<TR><TD PORT="header_pos">0</TD><TD PORT="header_size">...</TD><TD>Block</TD><TD PORT="header_type">header</TD></TR>
				<TR><TD PORT="blocks_pos">...</TD><TD PORT="blocks_size">...</TD><TD>Block</TD><TD PORT="blocks_type">blocks</TD></TR>
				<TR><TD COLSPAN="4" PORT="blocks__repeat">repeat until _.ends_section</TD></TR>
				<TR><TD COLSPAN="4" PORT="blocks__if">if  ((is_supported_version) &amp;&amp; (!(header.ends_section))) </TD></TR>
				<TR><TD PORT="skipped_blocks_pos">...</TD><TD PORT="skipped_blocks_size">...</TD><TD>SkippedBlock</TD><TD PORT="skipped_blocks_type">skipped_blocks</TD></TR>
				<TR><TD COLSPAN="4" PORT="skipped_blocks__repeat">repeat until _.ends_section</TD></TR>
				<TR><TD COLSPAN="4" PORT="skipped_blocks__if">if  ((!(is_supported_version)) &amp;&amp; (!(header.ends_section))) </TD></TR>
			</TABLE>>];
			section__inst__is_supported_version [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
				<TR><TD BGCOLOR="#E0FFE0">id</TD><TD BGCOLOR="#E0FFE0">value</TD></TR>
				<TR><TD>is_supported_version</TD><TD> ((header.body.version_major == 1) &amp;&amp; ( ((header.body.version_minor == 0) || (header.body.version_minor == 2)) )) </TD></TR>
			</TABLE>>];
			subgraph cluster__block {
				label="Pcapng::Section::Block";
				graph[style=dotted];

				block__seq [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
					<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
					<TR><TD PORT="block_type_pos">0</TD><TD PORT="block_type_size">4</TD><TD>u4→BlockType</TD><TD PORT="block_type_type">block_type</TD></TR>
					<TR><TD PORT="len_block_pos">4</TD><TD PORT="len_block_size">4</TD><TD>u4</TD><TD PORT="len_block_type">len_block</TD></TR>
					<TR><TD PORT="body_pos">8</TD><TD PORT="body_size">...</TD><TD>switch (block_type)</TD><TD PORT="body_type">body</TD></TR>
					<TR><TD PORT="len_block_trailing_pos">...</TD><TD PORT="len_block_trailing_size">4</TD><TD>u4</TD><TD PORT="len_block_trailing_type">len_block_trailing</TD></TR>
					<TR><TD COLSPAN="4" PORT="len_block_trailing__valid">must be equal to len_block</TD></TR>
				</TABLE>>];
				block__inst__ends_section [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
					<TR><TD BGCOLOR="#E0FFE0">id</TD><TD BGCOLOR="#E0FFE0">value</TD></TR>
					<TR><TD>ends_section</TD><TD> ((_io.eof?) || (next_block_type == [10, 13, 13, 10].pack('C*'))) </TD></TR>
				</TABLE>>];
				block__inst__next_block_type [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
					<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
					<TR><TD PORT="next_block_type_pos">_io.pos</TD><TD PORT="next_block_type_size">4</TD><TD></TD><TD PORT="next_block_type_type">next_block_type</TD></TR>
					<TR><TD COLSPAN="4" PORT="next_block_type__if">if !(_io.eof?)</TD></TR>
				</TABLE>>];
block__seq_body_switch [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
	<TR><TD BGCOLOR="#F0F2E4">case</TD><TD BGCOLOR="#F0F2E4">type</TD></TR>
	<TR><TD>:block_type_custom_copied</TD><TD PORT="case0">CustomBlock</TD></TR>
	<TR><TD>:block_type_custom_not_copied</TD><TD PORT="case1">CustomBlock</TD></TR>
	<TR><TD>:block_type_decryption_secrets</TD><TD PORT="case2">DecryptionSecretsBlock</TD></TR>
	<TR><TD>:block_type_enhanced_packet</TD><TD PORT="case3">EnhancedPacketBlock</TD></TR>
	<TR><TD>:block_type_interface_description</TD><TD PORT="case4">InterfaceDescriptionBlock</TD></TR>
	<TR><TD>:block_type_interface_statistics</TD><TD PORT="case5">InterfaceStatisticsBlock</TD></TR>
	<TR><TD>:block_type_name_resolution</TD><TD PORT="case6">NameResolutionBlock</TD></TR>
	<TR><TD>:block_type_packet</TD><TD PORT="case7">PacketBlock</TD></TR>
	<TR><TD>:block_type_section_header</TD><TD PORT="case8">SectionHeaderBlock</TD></TR>
	<TR><TD>:block_type_simple_packet</TD><TD PORT="case9">SimplePacketBlock</TD></TR>
</TABLE>>];
			}
			subgraph cluster__custom_block {
				label="Pcapng::Section::CustomBlock";
				graph[style=dotted];

				custom_block__seq [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
					<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
					<TR><TD PORT="pen_pos">0</TD><TD PORT="pen_size">4</TD><TD>u4</TD><TD PORT="pen_type">pen</TD></TR>
					<TR><TD PORT="custom_data_pos">4</TD><TD PORT="custom_data_size">⇲</TD><TD></TD><TD PORT="custom_data_type">custom_data</TD></TR>
				</TABLE>>];
			}
			subgraph cluster__custom_option_bytes {
				label="Pcapng::Section::CustomOptionBytes";
				graph[style=dotted];

				custom_option_bytes__seq [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
					<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
					<TR><TD PORT="pen_pos">0</TD><TD PORT="pen_size">4</TD><TD>u4</TD><TD PORT="pen_type">pen</TD></TR>
					<TR><TD COLSPAN="4" PORT="pen__if">if _io.size &gt;= 4</TD></TR>
					<TR><TD PORT="data_pos">4</TD><TD PORT="data_size">⇲</TD><TD></TD><TD PORT="data_type">data</TD></TR>
				</TABLE>>];
			}
			subgraph cluster__custom_option_text {
				label="Pcapng::Section::CustomOptionText";
				graph[style=dotted];

				custom_option_text__seq [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
					<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
					<TR><TD PORT="pen_pos">0</TD><TD PORT="pen_size">4</TD><TD>u4</TD><TD PORT="pen_type">pen</TD></TR>
					<TR><TD COLSPAN="4" PORT="pen__if">if _io.size &gt;= 4</TD></TR>
					<TR><TD PORT="value_pos">4</TD><TD PORT="value_size">⇲</TD><TD>str(UTF-8)</TD><TD PORT="value_type">value</TD></TR>
				</TABLE>>];
			}
			subgraph cluster__decryption_secrets_block {
				label="Pcapng::Section::DecryptionSecretsBlock";

digraph {
	rankdir=LR;
	node [shape=plaintext];
	subgraph cluster__linux_sll {
		label="LinuxSll";
		graph[style=dotted];

		linux_sll__seq [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
			<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
			<TR><TD PORT="packet_type_pos">0</TD><TD PORT="packet_type_size">2</TD><TD>u2be</TD><TD PORT="packet_type_type">packet_type</TD></TR>
			<TR><TD PORT="arphrd_type_pos">2</TD><TD PORT="arphrd_type_size">2</TD><TD>u2be</TD><TD PORT="arphrd_type_type">arphrd_type</TD></TR>
			<TR><TD PORT="address_length_pos">4</TD><TD PORT="address_length_size">2</TD><TD>u2be</TD><TD PORT="address_length_type">address_length</TD></TR>
			<TR><TD PORT="address_pos">6</TD><TD PORT="address_size">8</TD><TD></TD><TD PORT="address_type">address</TD></TR>
			<TR><TD PORT="protocol_pos">14</TD><TD PORT="protocol_size">2</TD><TD>u2be</TD><TD PORT="protocol_type">protocol</TD></TR>
			<TR><TD PORT="body_pos">16</TD><TD PORT="body_size">...</TD><TD>switch (protocol)</TD><TD PORT="body_type">body</TD></TR>
		</TABLE>>];
linux_sll__seq_body_switch [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
	<TR><TD BGCOLOR="#F0F2E4">case</TD><TD BGCOLOR="#F0F2E4">type</TD></TR>
	<TR><TD>2048</TD><TD PORT="case0">Ipv4Packet</TD></TR>
	<TR><TD>34525</TD><TD PORT="case1">Ipv6Packet</TD></TR>
</TABLE>>];
	}
	linux_sll__seq:body_type -> linux_sll__seq_body_switch [style=bold];
	linux_sll__seq_body_switch:case0 -> ipv4_packet__seq [style=bold];
	linux_sll__seq_body_switch:case1 -> ipv6_packet__seq [style=bold];
	linux_sll__seq:protocol_type -> linux_sll__seq:body_type [color="#404040"];
}

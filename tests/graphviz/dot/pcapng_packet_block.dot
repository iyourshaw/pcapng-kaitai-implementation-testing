digraph {
	rankdir=LR;
	node [shape=plaintext];
	subgraph cluster__pcapng_packet_block {
		label="PcapngPacketBlock";
		graph[style=dotted];

		pcapng_packet_block__seq [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
			<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
			<TR><TD PORT="interface_id_pos">0</TD><TD PORT="interface_id_size">2</TD><TD>u2</TD><TD PORT="interface_id_type">interface_id</TD></TR>
			<TR><TD PORT="drops_count_pos">2</TD><TD PORT="drops_count_size">2</TD><TD>u2</TD><TD PORT="drops_count_type">drops_count</TD></TR>
			<TR><TD PORT="ts_high_pos">4</TD><TD PORT="ts_high_size">4</TD><TD>u4</TD><TD PORT="ts_high_type">ts_high</TD></TR>
			<TR><TD PORT="ts_low_pos">8</TD><TD PORT="ts_low_size">4</TD><TD>u4</TD><TD PORT="ts_low_type">ts_low</TD></TR>
			<TR><TD PORT="len_packet_data_pos">12</TD><TD PORT="len_packet_data_size">4</TD><TD>u4</TD><TD PORT="len_packet_data_type">len_packet_data</TD></TR>
			<TR><TD PORT="len_original_pos">16</TD><TD PORT="len_original_size">4</TD><TD>u4</TD><TD PORT="len_original_type">len_original</TD></TR>
			<TR><TD PORT="packet_data_pos">20</TD><TD PORT="packet_data_size">len_packet_data</TD><TD></TD><TD PORT="packet_data_type">packet_data</TD></TR>
			<TR><TD PORT="padding_pos">...</TD><TD PORT="padding_size">(4 - len_packet_data % 4) % 4</TD><TD></TD><TD PORT="padding_type">padding</TD></TR>
			<TR><TD PORT="options_pos">...</TD><TD PORT="options_size">...</TD><TD>PcapngOptions</TD><TD PORT="options_type">options</TD></TR>
		</TABLE>>];
	}
	pcapng_packet_block__seq:len_packet_data_type -> pcapng_packet_block__seq:packet_data_size [color="#404040"];
	pcapng_packet_block__seq:len_packet_data_type -> pcapng_packet_block__seq:padding_size [color="#404040"];
	pcapng_packet_block__seq:options_type -> pcapng_options__seq [style=bold];
}

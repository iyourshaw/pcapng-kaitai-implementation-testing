digraph {
	rankdir=LR;
	node [shape=plaintext];
	subgraph cluster__pcapng_decryption_secrets_block {
		label="PcapngDecryptionSecretsBlock";
		graph[style=dotted];

		pcapng_decryption_secrets_block__seq [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
			<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
			<TR><TD PORT="secrets_type_pos">0</TD><TD PORT="secrets_type_size">4</TD><TD>u4→SecretsTypeEnum</TD><TD PORT="secrets_type_type">secrets_type</TD></TR>
			<TR><TD PORT="len_secrets_pos">4</TD><TD PORT="len_secrets_size">4</TD><TD>u4</TD><TD PORT="len_secrets_type">len_secrets</TD></TR>
			<TR><TD PORT="secrets_pos">8</TD><TD PORT="secrets_size">len_secrets</TD><TD></TD><TD PORT="secrets_type">secrets</TD></TR>
			<TR><TD PORT="padding_pos">...</TD><TD PORT="padding_size">(4 - len_secrets % 4) % 4</TD><TD></TD><TD PORT="padding_type">padding</TD></TR>
			<TR><TD PORT="options_pos">...</TD><TD PORT="options_size">...</TD><TD>PcapngOptions</TD><TD PORT="options_type">options</TD></TR>
		</TABLE>>];
	}
	pcapng_decryption_secrets_block__seq:len_secrets_type -> pcapng_decryption_secrets_block__seq:secrets_size [color="#404040"];
	pcapng_decryption_secrets_block__seq:len_secrets_type -> pcapng_decryption_secrets_block__seq:padding_size [color="#404040"];
	pcapng_decryption_secrets_block__seq:options_type -> pcapng_options__seq [style=bold];
}
